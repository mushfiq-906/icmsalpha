# Keep all subfolders for Jmol
!WorkFolder/Jmol/
!WorkFolder/Jmol/**

# Keep all subfolders for dnsjava
!WorkFolder/dnsjava/
!WorkFolder/dnsjava/**

# Keep all subfolders for tuxguitar (excluding large CSVs that exceed GitHub 100MB limit)
!WorkFolder/tuxguitar/
!WorkFolder/tuxguitar/**
WorkFolder/tuxguitar/Datasets/CloneGenealogy/Type3_Block_evolution_dataset.csv
WorkFolder/tuxguitar/Datasets/CloneGenealogy/Type3_Block_rev_pair.csv
WorkFolder/tuxguitar/Datasets/CloneGenealogy/Type3_Block_pairs.csv

# Build output
target/

# Oversized generated CSVs (>100MB, exceeds GitHub limit)
ml/results/file_folder_analysis/tuxguitar/tuxguitar_file-folder-analysis.csv
ml/results/similarity_classsize_analysis/tuxguitar/tuxguitar_similarity_classsize.csv

